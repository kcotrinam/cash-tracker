generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CurrencyCode {
  PEN
  USD
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringTransactionStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum AppLanguage {
  EN
  ES
}

enum CreditCardStatementStatus {
  PENDING
  PAID
  OVERDUE
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  passwordHash          String
  displayName           String
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  settings              UserSettings?
  refreshSessions       RefreshSession[]
  categories            Category[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  creditCards           CreditCard[]
  creditCardPayments    CreditCardPayment[]
  creditCardStatements  CreditCardStatement[]
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model UserSettings {
  userId          String          @id @db.Uuid
  defaultCurrency CurrencyCode    @default(PEN)
  timezone        String          @default("America/Lima")
  themePreference ThemePreference @default(SYSTEM)
  language        AppLanguage     @default(EN)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @db.Uuid
  name                  String
  normalizedName        String
  type                  TransactionType
  color                 String?
  icon                  String?
  isDefault             Boolean                @default(false)
  defaultKey            String?
  isFallback            Boolean                @default(false)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, type, normalizedName])
  @@unique([userId, defaultKey])
  @@index([userId, type, isActive])
}

model Transaction {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @db.Uuid
  categoryId             String                @db.Uuid
  recurringTransactionId String?               @db.Uuid
  creditCardId           String?               @db.Uuid
  type                   TransactionType
  amount                 Decimal               @db.Decimal(19, 4)
  currencyCode           CurrencyCode
  description            String?
  note                   String?
  occurredOn             DateTime              @db.Date
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category               Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringTransaction   RecurringTransaction? @relation("RecordedOccurrences", fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  creditCard             CreditCard?           @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  @@unique([recurringTransactionId, occurredOn])
  @@index([userId, occurredOn, type, currencyCode])
  @@index([categoryId])
  @@index([creditCardId, occurredOn])
}

model CreditCard {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  name           String
  currency       CurrencyCode
  creditLimit    Decimal             @db.Decimal(19, 4)
  initialBalance Decimal             @default(0) @db.Decimal(19, 4)
  closingDay     Int
  paymentDay     Int
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  payments       CreditCardPayment[]
  statements     CreditCardStatement[]

  @@index([userId, currency, isActive])
}

model CreditCardPayment {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  creditCardId String       @db.Uuid
  amount       Decimal      @db.Decimal(19, 4)
  currency     CurrencyCode
  paidOn       DateTime     @db.Date
  note         String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard   CreditCard   @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  applications CreditCardPaymentApplication[]

  @@index([userId, paidOn, currency])
  @@index([creditCardId, paidOn])
}

model CreditCardStatement {
  id               String                    @id @default(uuid()) @db.Uuid
  userId           String                    @db.Uuid
  creditCardId     String                    @db.Uuid
  periodStart      DateTime                  @db.Date
  closedOn         DateTime                  @db.Date
  dueOn            DateTime                  @db.Date
  statementBalance Decimal                   @db.Decimal(19, 4)
  minimumPayment   Decimal?                  @db.Decimal(19, 4)
  remainingBalance Decimal                   @db.Decimal(19, 4)
  status           CreditCardStatementStatus @default(PENDING)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(6)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard       CreditCard                @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  applications     CreditCardPaymentApplication[]

  @@unique([creditCardId, closedOn])
  @@index([userId, dueOn, status])
}

model CreditCardPaymentApplication {
  id           String              @id @default(uuid()) @db.Uuid
  paymentId    String              @db.Uuid
  statementId  String              @db.Uuid
  amount       Decimal             @db.Decimal(19, 4)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  payment      CreditCardPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  statement    CreditCardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([paymentId, statementId])
  @@index([statementId])
}

model RecurringTransaction {
  id                   String                     @id @default(uuid()) @db.Uuid
  userId               String                     @db.Uuid
  categoryId           String                     @db.Uuid
  type                 TransactionType
  description          String
  amount               Decimal                    @db.Decimal(19, 4)
  currency             CurrencyCode
  note                 String?
  frequency            RecurrenceFrequency        @default(MONTHLY)
  interval             Int                        @default(1)
  startDate            DateTime                   @db.Date
  endDate              DateTime?                  @db.Date
  nextOccurrenceDate   DateTime                   @db.Date
  anchorDay            Int?
  status               RecurringTransactionStatus @default(ACTIVE)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(6)
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recordedTransactions Transaction[]              @relation("RecordedOccurrences")

  @@index([userId, status, nextOccurrenceDate])
}
