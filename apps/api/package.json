    "@nestjs/swagger": "latest",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "class-transformer": "latest",
    "class-validator": "latest",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "joi": "latest",
    "pg": "^8.23.0",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@cashtracker/config": "workspace:*",
